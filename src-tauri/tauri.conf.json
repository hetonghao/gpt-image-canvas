{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Cove Design",
  "version": "1.0.5",
  "identifier": "com.aicove.design",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm desktop:prepare-sidecar",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../apps/web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Cove Design",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/sidecar"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBMTZEMThCOEU0MjlFNApSV1RrS2VTNEdHMmhCd1YxSXFwbVR4U0xGdno3QXBmK3pad2EyZkZkeENsbHJUd2Nmall3SEhFTgo=",
      "endpoints": [
        "https://ai-cove.com/downloads/latest.json"
      ]
    }
  }
}
