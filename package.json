{
  "name": "gpt-image-canvas",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.14.2",
  "description": "Local professional AI canvas powered by tldraw and GPT Image 2.",
  "engines": {
    "node": ">=24.15.0 <26"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm api:dev\" \"pnpm web:dev\"",
    "api:dev": "pnpm --filter @gpt-image-canvas/api dev",
    "web:dev": "pnpm --filter @gpt-image-canvas/web dev",
    "build": "pnpm --filter @gpt-image-canvas/shared build && pnpm --filter @gpt-image-canvas/web build && pnpm --filter @gpt-image-canvas/api build",
    "smoke:web:onboarding-fields": "pnpm --filter @gpt-image-canvas/api exec tsx ../../apps/web/src/features/provider-config/provider-onboarding-fields.smoke.ts",
    "smoke:web:onboarding": "pnpm --filter @gpt-image-canvas/api exec tsx ../../apps/web/src/features/canvas/provider-onboarding.smoke.ts",
    "smoke:web:provider-config": "pnpm --filter @gpt-image-canvas/api exec tsx ../../apps/web/src/features/provider-config/provider-config-save.smoke.ts",
    "smoke:web:provider-config-dialog": "pnpm --filter @gpt-image-canvas/api exec tsx ../../apps/web/src/features/provider-config/provider-config-dialog.smoke.ts",
    "smoke:web:provider-status-popover": "pnpm --filter @gpt-image-canvas/api exec tsx ../../apps/web/src/features/canvas/provider-status-popover.smoke.ts",
    "smoke:web:desktop-navigation": "pnpm --filter @gpt-image-canvas/api exec tsx ../../apps/web/src/features/canvas/desktop-navigation.smoke.ts",
    "smoke:web:home-desktop": "pnpm --filter @gpt-image-canvas/api exec tsx ../../apps/web/src/features/home/home-desktop.smoke.ts",
    "smoke:web:region-prompt": "pnpm --filter @gpt-image-canvas/api exec tsx ../../apps/web/src/features/canvas/region-prompt.smoke.ts",
    "smoke:web:region-prompt-icons": "pnpm --filter @gpt-image-canvas/api exec tsx ../../apps/web/src/features/canvas/region-prompt-icons.smoke.ts",
    "smoke:web:deferred-dialog-dependencies": "pnpm --filter @gpt-image-canvas/api exec tsx ../../apps/web/src/features/canvas/deferred-dialog-dependencies.smoke.ts",
    "smoke:web:deferred-canvas-startup-dependencies": "pnpm --filter @gpt-image-canvas/web build && pnpm --filter @gpt-image-canvas/api exec tsx ../../apps/web/src/features/canvas/deferred-canvas-startup-dependencies.smoke.ts",
    "smoke:web:generation-placeholder-motion": "pnpm --filter @gpt-image-canvas/api exec tsx ../../apps/web/src/features/canvas/generation-placeholder-motion.smoke.ts",
    "smoke:web:embedded-home-lazy": "pnpm --filter @gpt-image-canvas/api exec tsx ../../apps/web/src/features/canvas/embedded-home-lazy.smoke.ts",
    "smoke:web:font-dependencies": "pnpm --filter @gpt-image-canvas/api exec tsx ../../apps/web/src/styles/font-dependencies.smoke.ts",
    "smoke:web:boot-screen": "pnpm --filter @gpt-image-canvas/web build && pnpm --filter @gpt-image-canvas/api exec tsx ../../apps/web/src/boot-screen.smoke.ts",
    "smoke:web:prompt-pool-host-auth": "pnpm --filter @gpt-image-canvas/api exec tsx ../../apps/web/src/features/pool/prompt-pool-host-auth.smoke.ts",
    "smoke:web:prompt-pool-desktop-auth": "pnpm --filter @gpt-image-canvas/api exec tsx ../../apps/web/src/features/pool/prompt-pool-desktop-auth.smoke.ts",
    "smoke:web:desktop-runtime": "pnpm --filter @gpt-image-canvas/api exec tsx ../../apps/web/src/shared/desktop/desktop-runtime.smoke.ts",
    "smoke:web:desktop-auth": "pnpm --filter @gpt-image-canvas/api exec tsx ../../apps/web/src/shared/desktop/desktop-auth.smoke.ts",
    "smoke:web:desktop-updater": "pnpm --filter @gpt-image-canvas/api exec tsx ../../apps/web/src/shared/desktop/desktop-updater.smoke.ts",
    "smoke:web:desktop-update-integration": "pnpm --filter @gpt-image-canvas/api exec tsx ../../apps/web/src/shared/desktop/desktop-update-integration.smoke.ts",
    "smoke:api:prompt-pool": "pnpm --filter @gpt-image-canvas/shared build && pnpm --filter @gpt-image-canvas/api exec tsx src/smoke/prompt-pool-smoke.ts",
    "smoke:api:prompt-pool-public-hosted": "pnpm --filter @gpt-image-canvas/shared build && pnpm --filter @gpt-image-canvas/api exec tsx src/smoke/prompt-pool-public-hosted-smoke.ts",
    "smoke:api:desktop-auth": "pnpm --filter @gpt-image-canvas/api exec tsx src/smoke/desktop-auth-route.smoke.ts",
    "smoke:api:runtime-desktop-paths": "pnpm --filter @gpt-image-canvas/api exec tsx src/smoke/runtime-desktop-paths.smoke.ts",
    "smoke:api:region-summary": "pnpm --filter @gpt-image-canvas/shared build && pnpm --filter @gpt-image-canvas/api exec tsx src/smoke/region-summary-smoke.ts",
    "smoke:api:static-assets-cache": "pnpm --filter @gpt-image-canvas/api exec tsx src/server/static-assets-cache.smoke.ts",
    "typecheck": "pnpm --filter @gpt-image-canvas/shared typecheck && pnpm --filter @gpt-image-canvas/web typecheck && pnpm --filter @gpt-image-canvas/api typecheck",
    "start": "pnpm --filter @gpt-image-canvas/api start",
    "desktop:sync-version": "node scripts/sync-desktop-version.mjs",
    "desktop:prepare-sidecar": "node scripts/desktop-prepare-sidecar.mjs",
    "desktop:dev": "pnpm desktop:sync-version && tauri dev",
    "desktop:build": "node scripts/desktop-build.mjs",
    "desktop:validate-release": "node scripts/desktop-validate-release.mjs",
    "desktop:publish-downloads": "node scripts/desktop-publish-downloads.mjs",
    "desktop:assemble-release": "node scripts/desktop-assemble-release.mjs",
    "desktop:build:test": "node scripts/desktop-build.test.mjs && node scripts/desktop-prepare-sidecar.test.mjs && node scripts/desktop-publish-downloads.test.mjs && node scripts/desktop-validate-release.test.mjs && node scripts/desktop-assemble-release.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^24.12.2",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3"
  }
}
